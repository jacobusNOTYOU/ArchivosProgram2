//  verifica si es bisiesto
bool esBisiesto(Word a)
{
	bool bisiesto = false;
	if((a % 100) == 0)
		bisiesto = (a % 400) == 0;
	else
		bisiesto = (a % 4) == 0;
	return bisiesto;
}
void __fastcall TForm3::Button3Click(TObject *Sender)
{
	RegAlumno reg;
	fstream f(nom.c_str(), ios::binary | ios::in | ios::out);
	if(!f.fail())
	{
		while(!f.eof())
		{
			f.read((char*)&reg, sizeof(reg));
			if(!f.eof())
			{
				if(reg.fecha.mes == 12)
					reg.fecha.año++;
				if(reg.fecha.mes == 2)
				{
					if(esBisiesto(reg.fecha.año))
					{
						if(reg.fecha.año == 29)
						{
							reg.fecha.dia = 1;
							reg.fecha.mes++;
						}
						else
							reg.fecha.dia++;
					}
					else
					{
						if(reg.fecha.año == 28)
						{
							reg.fecha.dia = 1;
							reg.fecha.mes++;
						}
						else
							reg.fecha.dia++;
                    }
				}
				else if((reg.fecha.mes == 1) || (reg.fecha.mes == 3)
					|| (reg.fecha.mes == 5) || (reg.fecha.mes == 7)
					|| (reg.fecha.mes == 8) || (reg.fecha.mes == 10)
					|| (reg.fecha.mes == 12))
				{
					if(reg.fecha.dia == 31)
					{
						reg.fecha.dia = 1;
						if(reg.fecha.mes == 12)
							reg.fecha.mes = 1;
						else
							reg.fecha.mes++;
					}
					else
						reg.fecha.dia++;
				}
				else
				{
					if(reg.fecha.dia == 30)
					{
						reg.fecha.dia = 1;
						reg.fecha.mes++;
					}
					else
						reg.fecha.dia++;
				}

				f.seekg(-sizeof(reg), ios::cur);
				f.write((char*)& reg, sizeof(reg));
				f.seekg(sizeof(reg), ios::cur);
				f.seekg(-sizeof(reg), ios::cur);
			}
		}
		f.close();
        ShowMessage("Fechas modificadas.");
    }
}
