void __fastcall TForm3::FormCreate(TObject *Sender)
{
	ruta = "C:\\Users\\User\\Desktop\\ModelosProgram2Final\\modelo2\\Dat\\";
	nom = ruta + "Alumno.dat";
	fstream f(nom.c_str(), ios::binary | ios::in);
	if(f.fail())
	{
		f.close();
		f.open(nom.c_str(), ios::binary | ios::out);
