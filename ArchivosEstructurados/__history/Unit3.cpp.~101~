//  Actualiza un archivo de la estructura antigua (la primera) a uno de la
//  nueva estructura (la actual)
void __fastcall TForm3::Button6Click(TObject *Sender)
{
	RegAlumnoAnt rAnt;
	RegAlumno reg;
	fstream f1(nom.c_str(), ios::binary | ios::in);
	fstream f2("temporal.tmp", ios::binary | ios::out);
	if(!f1.fail())
	{
		while(!f1.eof())
		{
			f1.read((char*)& rAnt, sizeof(rAnt));
			if(!f1.eof())
			{
				reg.cod = rAnt.cod;
				/*
				 * 	Como ambos nombres son char[] no se puede directamente
				 *  asignar el valor del uno en el otro, por eso se usa la
				 *  funcion "strcpy()"
				*/
				strcpy(reg.nom, rAnt.nom);
				reg.fecha = rAnt.fecha;
				reg.marca = ' ';
				reg.telf = 0;
				f2.write((char*)& reg, sizeof(reg));
			}
		}
		f1.close();
		f2.close();
		remove(nom.c_str());
		rename("temporal.tmp", nom.c_str());
        ShowMessage("Estructura Modificada");
	}
