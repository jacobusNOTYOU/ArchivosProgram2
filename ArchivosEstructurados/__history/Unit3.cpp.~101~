//  Convierte texto en mayusculas
AnsiString Mayusculas(AnsiString x)
{
	AnsiString min = "qwertyuiopasdfghjklñzxcvbnmáéíóúü";
	AnsiString may = "QWERTYUIOPASDFGHJKLÑZXCVBNMÁÉÍÓÚÜ";
	byte i, p, n = x.Length();
	for(i = 1; i <= n; i++)
	{
		p = min.Pos(x[i]);
		if(p > 0)
			x[i] = may[p];
	}
	return x;
}
