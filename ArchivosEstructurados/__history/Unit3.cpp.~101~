//  Tarea: Elimnar los registros de los alumnos que tengan al menos 2 'o' en
//         su nombre.

//  Verifica si la cadena contiene 2 o mas 'o'
bool Verif2o(AnsiString nom)
{
	bool oo = false;
	byte c = 0;
	Cardinal n = nom.Length();
	Cardinal i = 1;
	while((i <= n) && !oo)
	{
		if(nom[i] == 'O')
			c++;
		if(nom[i] == 'o')
			c++;
		if(nom[i] == 'Ó')
			c++;
		if(nom[i] == 'ó')
			c++;
		if(c >= 2)
			oo = true;
		i++;
	}
	return oo;
}
