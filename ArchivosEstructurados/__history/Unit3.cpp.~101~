//  Busqueda Binaria
long int TForm3::BusAlumCod(Word codB)
{
	long int posi, a, b, c;
	bool hallado = false;
	posi = -1;
	RegIdxCod rIdx;
	fstream fi(nomIdx.c_str(), ios::binary | ios::in | ios::ate);
	if(!fi.fail())
	{
		a = 0;
		b = fi.tellg();
		b = b - sizeof(rIdx);
		while((a <= b) && !hallado)
		{
			c = (a + b) / 2;
			fi.seekg(c);
			fi.read((char*)& rIdx, sizeof(rIdx));
			if(rIdx.cod == codB)
			{
				posi = rIdx.pos;
				hallado = true;
			}
			else if(rIdx.cod < codB)
				b = c - sizeof(rIdx);
			else
				a = c + sizeof(rIdx);
		}
		fi.close();
	}

	return posi;
}

