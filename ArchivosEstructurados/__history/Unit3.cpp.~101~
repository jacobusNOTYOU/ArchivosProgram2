//  Crea un archivo de text con el contenido del archivo estructurado
void __fastcall TForm3::Button2Click(TObject *Sender)
{
	RegAlumno reg;
	AnsiString linea, lis;
	fstream f(nom.c_str(), ios::binary | ios::in);
	lis = ruta + "Listado.csv";
	fstream t(lis.c_str(), ios::out);
	if(!f.fail())
	{
		linea = "";
		while(!f.eof())
		{
			f.read((char*)& reg, sizeof(reg));
			//  Verifica si no se leyo el EOF y si el registro no esta marcado
			//	como borrado
			if(!f.eof() && (reg.marca != '*'))
			{
				linea = IntToStr(reg.cod) + "," + reg.nom + "," + reg.fecha.dia
						+ "," + reg.fecha.mes + "," + reg.fecha.año + ","
						+ reg.telf;
				byte n = linea.Length();
				for(byte i = 1; i <= n; i++)
					t.put(linea[i]);
				t.put('\n');
			}
		}
		f.close();
		t.close();
		ShowMessage("Datos modificados");
	}
}
