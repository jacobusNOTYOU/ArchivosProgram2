//  Ordenamiento SelectionSort
void TForm3::SelectionSort()
{
	RegIdxCod rIdx1, rIdx2, rIdx3;
	Cardinal a, b, c;
	long n;
	fstream fi(nomIdx.c_str(), ios::binary | ios::in | ios::out | ios::ate);
	if(!fi.fail())
	{
		n = fi.tellg();
		n = n - sizeof(rIdx1);
		a = 0;
		fi.seekg(a);
		fi.read((char*)& rIdx3, sizeof(rIdx3));
		while(a < n)
		{

			c = a;
			rIdx1.cod = rIdx3.cod;
            rIdx1.pos = rIdx3.pos;
			b = c + sizeof(rIdx2);

			while(b <= n)
			{
				fi.seekg(b);
				fi.read((char*)& rIdx2, sizeof(rIdx2));
				if(rIdx1.cod > rIdx2.cod)
				{
					c = b;
					rIdx1.cod = rIdx2.cod;
					rIdx1.pos = rIdx2.pos;
				}
				b = b + sizeof(rIdx2);
			}
			if(a != c)
			{
				fi.seekg(a);
				fi.write((char*)& rIdx1, sizeof(rIdx1));
				fi.seekg(c);
				fi.write((char*)& rIdx3, sizeof(rIdx3));
			}

			a = a + sizeof(rIdx3);
			fi.seekg(a);
			fi.read((char*)& rIdx3, sizeof(rIdx3));
		}
		fi.close();
        ShowMessage("Indice Ordenado");
	}
}
void __fastcall TForm3::Button9Click(TObject *Sender)
