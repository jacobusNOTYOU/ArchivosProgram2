		char c;
		fstream f(nom.c_str(), ios::in);
		fstream t("temporal.txt", ios::out);
		if(!f.fail())
		{
			while(!f.eof())
			{
				//  Leer Una Linea
                lin = "";
				while(!f.eof() && (f.peek() != '\n'))
				{
					f.get(c);
					lin = lin + c;
				}
				//  Modificar una linea
				lin = intercambiarPalabras(lin);
				//  Escribir una linea en temporal
				for(int i = 1; i <= lin.Length(); i++)
					t.put(lin[i]);
				t.put('\n');
			}
			f.close();
			t.close();
